{
  "listen": "0.0.0.0:8505",
  "authMode": "proxy",
  "allowedOrigins": ["http://replace-with-your-intranet-host:8505"],
  "workspaceRoots": ["/root/dev"],
  "claudePath": "/usr/bin/claude",
  "maxLiveSessions": 4,
  "idleCloseMinutes": 30,
  "autoCompactBeforeExpiry": false,
  "usageAudit": { "enabled": true },
  "terminal": {
    "maxTerminals": 8,
    "maxPerProject": 4
  }
}
